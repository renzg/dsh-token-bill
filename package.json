{
  "name": "@zhiyu.pub/dsh-token-bill",
  "version": "0.1.5",
  "private": false,
  "type": "module",
  "description": "Token 账单：本轮会话与汇总账单、协作默契度、动作优化，叠加时间/任务/模型/工具/关联图，全部本机读取。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README*.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/demo-*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renzg/dsh-token-bill.git"
  },
  "homepage": "https://github.com/renzg/dsh-token-bill",
  "bugs": {
    "url": "https://github.com/renzg/dsh-token-bill/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
